{
    "version": 3,
    "configurePresets": [
        {
            "name": "host",
            "displayName": "Host tests (gcc + Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/host",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "host-sanitize",
            "displayName": "Host tests with ASan/UBSan (Linux/WSL/CI only)",
            "inherits": "host",
            "binaryDir": "${sourceDir}/build/host-sanitize",
            "cacheVariables": {
                "WIOE5_SANITIZE": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "host", "configurePreset": "host" },
        { "name": "host-sanitize", "configurePreset": "host-sanitize" }
    ],
    "testPresets": [
        {
            "name": "host",
            "configurePreset": "host",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "host-sanitize",
            "configurePreset": "host-sanitize",
            "output": { "outputOnFailure": true }
        }
    ]
}
